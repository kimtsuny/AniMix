generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int        @id @default(autoincrement())
  username  String     @unique
  email     String     @unique
  password  String
  createdAt DateTime   @default(now())
  favorites Favorite[]
}

model Anime {
  id               Int                    @id @default(autoincrement())
  anilistId        Int                    @unique
  title            String
  description      String?
  coverImage       String?
  bannerImage      String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  providerMappings AnimeProviderMapping[]
  seasons          AnimeSeason[]
  favorites        Favorite[]
}

model AnimeSeason {
  id               Int                          @id @default(autoincrement())
  animeId          Int
  anilistId        Int?
  number           Int
  title            String?
  provider         String?
  providerId       String?
  createdAt        DateTime                     @default(now())
  updatedAt        DateTime                     @updatedAt
  anime            Anime                        @relation(fields: [animeId], references: [id], onDelete: Cascade)
  episodes         Episode[]
  providerMappings AnimeSeasonProviderMapping[]

  @@unique([animeId, number])
  @@unique([provider, providerId])
  @@index([anilistId])
}

model Favorite {
  id        Int      @id @default(autoincrement())
  animeId   Int
  createdAt DateTime @default(now())
  userId    Int
  anime     Anime    @relation(fields: [animeId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, animeId])
}

model AnimeProviderMapping {
  id         Int    @id @default(autoincrement())
  animeId    Int
  provider   String
  providerId String
  anime      Anime  @relation(fields: [animeId], references: [id], onDelete: Cascade)

  @@unique([animeId, provider])
  @@unique([provider, providerId])
}

model AnimeSeasonProviderMapping {
  id                      Int                      @id @default(autoincrement())
  seasonId                Int
  provider                String
  providerId              String
  partNumber              Int                      @default(1)
  episodeOffset           Int                      @default(0)
  episodeCount            Int                      @default(0)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  season                  AnimeSeason              @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  episodeProviderMappings EpisodeProviderMapping[]

  @@unique([seasonId, provider, partNumber])
  @@unique([provider, providerId])
  @@index([seasonId])
}

model Episode {
  id               Int                      @id @default(autoincrement())
  number           Int
  title            String?
  thumbnail        String?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  seasonId         Int
  season           AnimeSeason              @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  providerMappings EpisodeProviderMapping[]

  @@unique([seasonId, number])
}

model EpisodeProviderMapping {
  id                      Int                         @id @default(autoincrement())
  episodeId               Int
  provider                String
  providerId              String
  providerSeasonMappingId Int?
  episode                 Episode                     @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  providerSeasonMapping   AnimeSeasonProviderMapping? @relation(fields: [providerSeasonMappingId], references: [id], onDelete: SetNull)

  @@unique([episodeId, provider])
  @@unique([provider, providerId])
  @@index([providerSeasonMappingId])
}

